---
import { getCollection } from 'astro:content';
import WorkDetailPage from '../../../components/pages/WorkDetailPage.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('works')).filter((e) => e.id.endsWith('.en'));
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.en$/, '') },
    props: { entry },
  }));
}
const { entry } = Astro.props;
---

<WorkDetailPage entry={entry} lang="en" />
