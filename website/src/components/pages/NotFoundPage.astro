---
import Base from '../../layouts/Base.astro';
import PageRail from '../PageRail.astro';
import { ui, type UIKey, type Lang } from '../../i18n/ui';
import { pathFor } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = (key: UIKey): string => ui[lang][key];
---

<Base lang={lang} canonical="" title={t('404.title')}>
  <PageRail lang={lang} sections={[{ id: 'mancante', label: '404.title' }]} />
  <section class="section nf" id="mancante">
    <div class="container">
      <p class="nf__code" aria-hidden="true">; LAYER NOT FOUND</p>
      <h1 class="nf__title">{t('404.title')}</h1>
      <p class="nf__text">{t('404.text')}</p>
      <a class="btn btn--solid" href={pathFor('', lang)}>{t('404.cta')}</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(5rem, 14vw, 10rem);
  }
  .nf__code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--purple-text);
  }
  .nf__title {
    font-size: var(--text-2xl);
    margin-top: 0.8rem;
  }
  .nf__text {
    margin-top: 0.9rem;
    max-width: 46ch;
    color: var(--muted);
  }
  .nf a.btn {
    margin-top: 2.2rem;
  }
</style>
