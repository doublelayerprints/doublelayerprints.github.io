---
import Base from '../../layouts/Base.astro';
import LayerLines from '../LayerLines.astro';
import PageRail from '../PageRail.astro';
import { ui, type UIKey, type Lang } from '../../i18n/ui';
import { SITE, whatsappLink } from '../../consts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = (key: UIKey): string => ui[lang][key];
const prefill = t('contact.whatsappPrefill');

const icons = {
  ig: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r="0.4" fill="currentColor" stroke="none"></circle></svg>`,
  email: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3.5 7 8.5 6 8.5-6"></path></svg>`,
  wa: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5a8.5 8.5 0 0 0-7.3 12.8L3.5 20.5l4.3-1.1A8.5 8.5 0 1 0 12 3.5Z"></path><path d="M9 8.5c.4 2.7 2.1 4.5 4.8 4.9"></path></svg>`,
};

const channels = [
  {
    id: 'ig' as const,
    name: 'Instagram',
    handle: `@${SITE.instagram.handle}`,
    href: SITE.instagram.url,
    desc: t('contact.ig.desc'),
    action: t('contact.ig.action'),
    external: true,
  },
  {
    id: 'email' as const,
    name: 'Email',
    handle: SITE.email,
    href: `mailto:${SITE.email}`,
    desc: t('contact.email.desc'),
    action: t('contact.email.action'),
    external: false,
  },
  {
    id: 'wa' as const,
    name: 'WhatsApp',
    handle: SITE.whatsapp.display,
    href: whatsappLink(prefill),
    desc: t('contact.wa.desc'),
    action: t('contact.wa.action'),
    external: true,
  },
];
---

<Base lang={lang} canonical="contatti" title={`${t('contact.title')} · ${SITE.name}`}>
  <PageRail lang={lang} sections={[{ id: 'canali', label: 'rail.talk' }]} />
  <section class="section" id="canali">
    <div class="container">
      <div class="section-head">
        <span class="section-eyebrow">{t('contact.eyebrow')}</span>
        <h1 class="section-title">{t('contact.title')}</h1>
        <p class="section-intro">{t('contact.intro')}</p>
      </div>

      <div class="channels">
        {
          channels.map((c) => (
            <article class="chan">
              <div class="chan__icon" set:html={icons[c.id]} />
              <h2 class="chan__name">{c.name}</h2>
              <p class="chan__handle">{c.handle}</p>
              <p class="chan__desc">{c.desc}</p>
              <a
                class="link chan__action"
                href={c.href}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener' : undefined}
              >
                {c.action}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <div class="container">
    <LayerLines gold />
  </div>
</Base>

<style>
  .channels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.4rem, 3vw, 2.4rem);
  }
  @media (max-width: 860px) {
    .channels {
      grid-template-columns: 1fr;
    }
  }

  .chan {
    position: relative;
    border: 1px solid var(--line-dark);
    background: var(--paper);
    padding: 1.9rem 1.7rem 2rem;
    transition: border-color 0.18s ease;
  }
  .chan::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.28s var(--ease-lay);
  }
  .chan:hover {
    border-color: var(--purple-text);
  }
  .chan:hover::before {
    transform: scaleX(1);
  }

  .chan__icon {
    width: 30px;
    height: 30px;
    color: var(--purple-text);
  }
  .chan__icon svg {
    width: 100%;
    height: 100%;
  }

  .chan__name {
    font-size: 1.35rem;
    margin-top: 1.1rem;
  }
  .chan__handle {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
    word-break: break-all;
  }
  .chan__desc {
    margin-top: 1rem;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 36ch;
  }
  .chan__action {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--purple-text);
  }
</style>
