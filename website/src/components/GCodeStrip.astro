---
/**
 * La colonna di G-code dell'hero: vera sintassi da slicer,
 * evoca il codice con cui ogni pezzo nasce. Puramente decorativa.
 */
---

<aside class="gcode" aria-hidden="true">
  <pre><span class="gl"><span class="c">; generated by DoubleLayeR</span></span>
<span class="gl">M104 S215</span>
<span class="gl">M140 S60</span>
<span class="gl">G90</span>
<span class="gl">M83</span>
<span class="gl">G92 E0.0</span>
<span class="gl">G28 W <span class="c">; home</span></span>
<span class="gl"><span class="c">; LAYER:001</span></span>
<span class="gl"><span class="c">;Z:0.200</span></span>
<span class="gl">G1 E-0.8 F2100</span>
<span class="gl">G1 Z0.200 F10800</span>
<span class="gl">G1 X84.122 Y96.410 F7800</span>
<span class="gl">G1 E0.8 F2700</span>
<span class="gl">G1 X124.206 Y96.412 E1.8426</span>
<span class="gl">G1 X124.206 Y136.634 E3.2851</span>
<span class="gl">G1 X106.494 Y158.240 E4.7118</span>
<span class="gl">G1 X84.310 Y166.104 E5.4910</span>
<span class="gl"><span class="c">; LAYER:002</span></span>
<span class="gl"><span class="c">;Z:0.400</span></span>
<span class="gl">G1 E-0.8 F2100</span>
<span class="gl">G1 X96.710 Y102.744 F7800</span>
<span class="gl">G1 E0.8 F2700</span>
<span class="gl">G1 X124.206 Y96.412 E2.0014</span>
<span class="gl">G1 X150.918 Y118.026 E4.2218</span>
<span class="gl"><span class="c">; LAYER:147</span></span>
<span class="gl"><span class="c">;Z:29.400</span></span>
<span class="gl">G1 X12.406 Y18.222 F7800</span>
<span class="gl"><span class="c">; PRINT COMPLETE</span></span>
<span class="gl">M104 S0</span>
<span class="gl">M140 S0</span>
<span class="gl">M107</span></pre>
</aside>

<style>
  .gcode {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    width: 12.5rem;
    pointer-events: none;
    user-select: none;
    overflow: hidden;
  }

  .gcode pre {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 2.1;
    color: var(--muted);
    opacity: 0.55;
    white-space: pre;
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 18%,
      black 74%,
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 18%,
      black 74%,
      transparent 100%
    );
  }

  /* i commenti del G-code, nei slicer sono colorati */
  .gcode .c {
    color: color-mix(in srgb, var(--purple) 45%, var(--muted));
  }

  /* Righe: la riga in esecuzione si accende durante la scena.
     Accento "macchina": viola nel tema chiaro, oro nel tema scuro. */
  .gcode .gl {
    display: block;
  }
  .gcode .gl.exec {
    background: color-mix(in srgb, var(--print-accent) 30%, transparent);
    box-shadow: inset 2px 0 0 var(--print-accent);
  }

  @media (max-width: 1180px) {
    .gcode {
      display: none;
    }
  }
</style>
