---
/**
 * La colonna di G-code dell'hero: vera sintassi da slicer,
 * evoca il codice con cui ogni pezzo nasce. Puramente decorativa.
 */
---

<aside class="gcode" aria-hidden="true">
  <pre><span class="c">; generated by DoubleLayeR</span>
M104 S215
M140 S60
G90
M83
G92 E0.0
G28 W <span class="c">; home</span>
<span class="c">; LAYER:001</span>
<span class="c">;Z:0.200</span>
G1 E-0.8 F2100
G1 Z0.200 F10800
G1 X84.122 Y96.410 F7800
G1 E0.8 F2700
G1 X124.206 Y96.412 E1.8426
G1 X124.206 Y136.634 E3.2851
G1 X106.494 Y158.240 E4.7118
G1 X84.310 Y166.104 E5.4910
<span class="c">; LAYER:002</span>
<span class="c">;Z:0.400</span>
G1 E-0.8 F2100
G1 X96.710 Y102.744 F7800
G1 E0.8 F2700
G1 X124.206 Y96.412 E2.0014
G1 X150.918 Y118.026 E4.2218
