</aside>

<style>
  .gcode {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    width: 12.5rem;
    pointer-events: none;
    user-select: none;
    overflow: hidden;
  }

  .gcode pre {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 2.1;
    color: var(--muted);
    opacity: 0.55;
    white-space: pre;
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 18%,
      black 74%,
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 18%,
      black 74%,
      transparent 100%
    );
  }

  /* i commenti del G-code, nei slicer sono colorati */
  .gcode .c {
    color: color-mix(in srgb, var(--purple) 45%, var(--muted));
  }

  @media (max-width: 1180px) {
    .gcode {
      display: none;
    }
  }
</style>
