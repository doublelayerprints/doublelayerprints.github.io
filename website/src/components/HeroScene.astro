---
/**
 * Scena hero "Deposizione" — l'intro che stampa l'hero strato per
 * strato all'arrivo in home. Dal 2026-10-16 è una timeline temporale
 * (~2.35s): prima il progresso era schiavizzato allo scroll, con
 * l'hero pinnato su uno stage da 240svh; ora la pagina è alta quanto
 * il suo contenuto e lo scroll scende dal primo istante.
 * Il primo paint è la pagina intera (il riposo coincide con i default
 * CSS), poi la timeline percorre le stesse finestre di prima: pausa,
 * dissolvenza, piatto, stampa a strati (foto + scritta), rilascio.
 * Qualsiasi input — rotella, touch, tastiera, scroll reale — completa
 * l'intro all'istante (data-scene-skip rilascia subito anche tagline
 * e CTA). Se la pagina si apre già scrollata (back/refresh) niente
 * intro; con bfcache si riprende a riposo. Attiva solo con JS e senza
 * prefers-reduced-motion, a ogni larghezza (sotto 760px era statica
 * fino al 2026-10-16: le ragioni — pin, stage allungato, flick —
 * non esistono più senza scroll). Il JS è solo il clock; le
 * trasformazioni stanno nel CSS.
 */
interface Props {
  id?: string;
}
const { id } = Astro.props;
---

<script is:inline>
  (function () {
    var ok = false;
    try {
      ok = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch (e) {
      ok = true;
    }
    if (ok) document.documentElement.setAttribute('data-motion-ok', '');
  })();
</script>

<div class="hero-stage" data-hero-stage id={id}>
  <div class="hero-scene" data-hero-scene>
    <slot />
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement;
    if (!root.hasAttribute('data-motion-ok')) return;
    var stage = document.querySelector('[data-hero-stage]');
    if (!stage) return;
    var scene = stage.querySelector('[data-hero-scene]');
    if (!scene) return;

    var clamp = function (v, a, b) { return Math.min(Math.max(v, a), b); };
    var wing = function (p, a, b) { return clamp((p - a) / (b - a), 0, 1); };
    var ease = function (t) { return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2; };
    var W = function (p, a, b) { return ease(wing(p, a, b)); };

    var rows = Array.prototype.slice.call(document.querySelectorAll('.gcode .gl'));
    var count = scene.querySelector('[data-count]');

    var pad3 = function (n) { return String(n).padStart(3, '0'); };

    /* Le finestre della scena sono quelle di sempre (documentate in
       global.css): 10–24% cancella il materiale (foto + scritta —
       l'inchiostro scivola su −14px mentre svanisce), 4–26% il bed
       si arma, 28–60% la finestra di stampa (foto E scritta, a
       strati con anteprima al registro, testa viva solo lì, il
       contatore e la riga G-code in esecuzione), 68–90% rilascio
       (l'inchiostro torna pieno, le fasce svaniscono). I
       plate-ghost vivono SOLO nella finestra di dissolvenza.
       Il progresso ora arriva dal tempo, non dallo scroll: stessa
       estetica, driver diverso. */
    var apply = function (p) {
      var pFade = W(p, 0.10, 0.24);
      var pp = W(p, 0.28, 0.60);
      var printEnd = 1 - W(p, 0.68, 0.90);
      var photoGhost = pFade * printEnd;
      var kBed = Math.sin(W(p, 0.04, 0.26) * Math.PI);
      var kGhost = Math.sin(W(p, 0.10, 0.24) * Math.PI);
      var kPress = Math.sin(W(p, 0.68, 0.95) * Math.PI);
      var kHead = Math.min(1, pp * 8) * printEnd;
      var kWordGhost = pFade * printEnd;

      var s = scene.style;
      s.setProperty('--p', p.toFixed(4));
      s.setProperty('--pp', pp.toFixed(4));
      s.setProperty('--k-photo-ghost', photoGhost.toFixed(4));
      s.setProperty('--k-word-ghost', kWordGhost.toFixed(4));
      s.setProperty('--k-pfade', (1 - printEnd).toFixed(4));
      s.setProperty('--k-bed', kBed.toFixed(4));
      s.setProperty('--k-ghost', kGhost.toFixed(4));
      s.setProperty('--k-count', kHead.toFixed(4));
      s.setProperty('--k-head', kHead.toFixed(4));
      s.setProperty('--k-press', kPress.toFixed(4));

      if (count) {
        var n = 1 + Math.round(79 * pp);
        count.textContent = 'LAYER ' + pad3(n) + '/080';
      }

      if (rows.length) {
        var active = clamp(Math.floor(pp * rows.length), 0, rows.length - 1);
        for (var r = 0; r < rows.length; r++) {
          rows[r].classList.toggle('exec', r === active);
        }
      }
    };

    /* Timeline: segmenti [pDa, pA, secondi]. Le durate comprimono in
       ~2.35s ciò che prima dipendeva da ~1.4 schermate di scroll.
       Dentro ogni finestra vale l'easing W(); il raccordo tra
       segmenti è lineare sulla stessa p, quindi senza scatti. */
    var SEGS = [
      [0.0, 0.10, 0.20],  /* pausa: la pagina intera si vede */
      [0.10, 0.28, 0.35], /* dissolvenza + bed che si arma */
      [0.28, 0.60, 1.25], /* stampa strato per strato */
      [0.60, 0.68, 0.10], /* pausa sull'oggetto stampato */
      [0.68, 1.00, 0.45]  /* rilascio: l'inchiostro torna pieno */
    ];
    var TOTAL = 0;
    for (var i = 0; i < SEGS.length; i++) TOTAL += SEGS[i][2];

    var pAt = function (t) {
      var i, s;
      t = clamp(t, 0, TOTAL);
      for (i = 0; i < SEGS.length; i++) {
        s = SEGS[i];
        if (t <= s[2]) return s[0] + (s[1] - s[0]) * (t / s[2]);
        t -= s[2];
      }
      return 1;
    };

    var raf = 0;
    var t0 = 0;
    var started = false;
    var done = false;

    var stopLoop = function () {
      if (raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    };

    var tick = function (now) {
      raf = 0;
      if (!t0) t0 = now;
      var p = pAt((now - t0) / 1000);
      apply(p);
      if (p >= 1) {
        done = true;
        detachSkip();
        /* A riposo la scena coincide con i default CSS: via
           l'attributo, si rilasciano i layer will-change. */
        stage.removeAttribute('data-scene-live');
        return;
      }
      raf = requestAnimationFrame(tick);
    };

    /* Skip: qualsiasi intento di scroll completa l'intro. Il listener
       `scroll` copre anche il ripristino della posizione (back dal
       browser, refresh a metà pagina): se la pagina si apre già
       scrollata l'intro non parte proprio. */
    var SKIP_KEYS = ['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', ' ', 'End', 'Home'];
    var skipOn = false;

    var onWheel = function () { finish(); };
    var onTouch = function () { finish(); };
    var onScroll = function () { if (window.scrollY > 4) finish(); };
    var onKey = function (e) {
      if (SKIP_KEYS.indexOf(e.key) !== -1) finish();
    };

    var attachSkip = function () {
      if (skipOn) return;
      skipOn = true;
      window.addEventListener('wheel', onWheel, { passive: true });
      window.addEventListener('touchstart', onTouch, { passive: true });
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('keydown', onKey);
    };

    var detachSkip = function () {
      if (!skipOn) return;
      skipOn = false;
      window.removeEventListener('wheel', onWheel);
      window.removeEventListener('touchstart', onTouch);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('keydown', onKey);
    };

    var finish = function () {
      if (done) return;
      done = true;
      stopLoop();
      detachSkip();
      /* Rilascia subito tagline e CTA (niente attesa dei delay) e
         fissa il riposo pieno: la pagina è semplicemente visibile. */
      stage.setAttribute('data-scene-skip', '');
      stage.removeAttribute('data-scene-live');
      apply(1);
    };

    window.addEventListener('pageshow', function (e) {
      if (e.persisted) finish(); /* bfcache: si riprende a riposo */
    });

    stage.setAttribute('data-scene-live', '');

    /* Pagina aperta già scrollata: niente scena, solo il rilascio
       dei delay di tagline/CTA. */
    if (window.scrollY > 4) {
      finish();
    } else {
      attachSkip();
    }

    /* Parte al primo frame utile: dopo i font (le copie a strati
       della scritta devono misurarsi col carattere vero), con rete
       di sicurezza se fonts.ready tarda. */
    var kickoff = function () {
      if (started || done) return;
      started = true;
      apply(0);
      raf = requestAnimationFrame(tick);
    };
    var kicked = false;
    var kickoffGuard = function () {
      if (kicked) return;
      kicked = true;
      kickoff();
    };
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(kickoffGuard);
    }
    setTimeout(kickoffGuard, 700);
  })();
</script>
