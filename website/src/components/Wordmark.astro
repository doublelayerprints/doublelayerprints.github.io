---
/**
 * Il wordmark: due strati tipografici.
 * "Double" in Filament Purple, "LayeR" in Nozzle Ink,
 * con un'eco in Silk Gold fuori registro — il "layer shift"
 * che si mette in registro al caricamento della pagina.
 * In hero è l'h1 della pagina; altrove (footer) è testo semplice.
 */
interface Props {
  size?: 'hero' | 'footer';
  onDark?: boolean;
}
const { size = 'hero', onDark = false } = Astro.props;
const Tag = size === 'hero' ? 'h1' : 'p';
---

<Tag class:list={['mark', `mark--${size}`, { 'mark--on-dark': onDark }]}>
  <span class="sr-only">Double LayeR Prints</span>
  <span class="mark__visual" aria-hidden="true">
    <span class="mark__a">Double</span>
    <span class="mark__b">
      <span class="mark__b-echo">LayeR</span>
      <span class="mark__b-ink">LayeR</span>
    </span>
    <span class="mark__sub">prints</span>
  </span>
</Tag>

<style>
  .mark {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 0.94;
    text-wrap: nowrap;
  }

  .mark__visual {
    display: block;
  }

  .mark__a,
  .mark__b {
    display: block;
  }

  .mark__a {
    color: var(--purple-display);
  }

  .mark__b-ink,
  .mark__b-echo {
    display: block;
  }

  .mark__b {
    position: relative;
    color: var(--ink);
  }

  .mark--on-dark .mark__a {
    color: var(--purple-on-dark);
  }

  .mark--on-dark .mark__b {
    color: var(--on-dark-text);
  }

  /* L'eco: il secondo strato, in Silk Gold, fuori registro */
  .mark__b-echo {
    position: absolute;
    inset: 0;
    color: var(--gold);
    z-index: -1;
    transform: translate(0.085em, 0.05em);
  }

  .mark__sub {
    display: block;
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--text-md);
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .mark--on-dark .mark__sub {
    color: var(--gold);
  }

  /* Dimensioni */
  .mark--hero {
    font-size: var(--text-hero);
  }
  .mark--footer {
    font-size: clamp(2.6rem, 7vw, 4.8rem);
  }

  /* Il momento coreografato: l'eco si mette in registro */
  @keyframes echo-register {
    from {
      transform: translate(0.42em, -0.18em);
      opacity: 0;
    }
    55% {
      opacity: 1;
    }
    to {
      transform: translate(0.085em, 0.05em);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .mark--hero .mark__b-echo {
      animation: echo-register 0.75s var(--ease-snap) 0.2s both;
    }
  }
</style>
