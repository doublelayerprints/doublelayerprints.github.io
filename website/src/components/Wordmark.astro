---
/**
 * Il wordmark: due strati tipografici.
 * "Double" in Filament Purple, "LayeR" in Silk Gold,
 * con un'eco viola fuori registro — il "layer shift"
 * che si mette in registro al caricamento della pagina.
 * In hero è l'h1 della pagina; altrove (footer) è testo semplice.
 *
 * Variante `printable`: lo stack dello slicer — 40 copie del
 * wordmark tagliate a strati che durante la scena "Deposizione"
 * si depositano bottom-up (2026-10-13 h: ripristino dello slicing
 * della scritta; l'arrivo di ogni strato NON scivola: solo
 * dissolvenza in registro, così i glifi non si leggono mai
 * "tagliati"). Aria residua: senza scena restano opacity 0.
 */
interface Props {
  size?: 'hero' | 'footer';
  onDark?: boolean;
  printable?: boolean;
}
const { size = 'hero', onDark = false, printable = false } = Astro.props;
const Tag = size === 'hero' ? 'h1' : 'p';
const N_SLICES = 40;
---

<Tag class:list={['mark', `mark--${size}`, { 'mark--on-dark': onDark }]}>
  <span class="sr-only">Double LayeR Prints</span>
  <span class="mark__visual" aria-hidden="true">
    <span class="mark__a">Double</span>
    <span class="mark__b">
      {size === 'hero' && <span class="mark__b-deep">LayeR</span>}
      <span class="mark__b-echo">LayeR</span>
      <span class="mark__b-ink">LayeR</span>
    </span>
    <span class="mark__sub">prints</span>
    {
      printable && (
        <span class="mark__slicestack" aria-hidden="true">
          {Array.from({ length: N_SLICES }).map((_, i) => (
            <span class="mark__slice" style={`--i:${i}`} aria-hidden="true">
              <span class="mark__slice-a">Double</span>
              <span class="mark__slice-b">LayeR</span>
              <span class="mark__slice-sub">prints</span>
            </span>
          ))}
        </span>
      )
    }
    {printable && <span class="mark__print-head" aria-hidden="true"></span>}
  </span>
</Tag>

<style>
  .mark {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 0.94;
    text-wrap: nowrap;
  }

  /* Spazio per l'inchiostro che sborda dal box di layout: il bowl della
     "e" di "Double" e le aste alte di "D/b/l" (line-height 0.94) escono
     di 2–3px; senza padding, le copie a strati (clip-path a inset 0
     orizzontale) le tagliano durante la scena. Il margin-top compensa:
     il layout visivo resta identico al avere. (Soluzione 2, 2026-10-13). */
  .mark--hero .mark__visual {
    position: relative;
    padding-top: 0.05em; /* le aste alte non vengono rasentate */
    margin-top: -0.05em; /* compensazione: nulla si sposta */
    padding-right: 0.08em; /* il bowl della "e" respira */
  }

  .mark__visual {
    display: block;
  }

  .mark__a,
  .mark__b {
    display: block;
  }

  .mark__a {
    color: var(--purple-display);
  }

  .mark__b-ink,
  .mark__b-echo {
    display: block;
  }

  .mark__b {
    position: relative;
    color: var(--mark-layer);
  }

  .mark--on-dark .mark__a {
    color: var(--purple-on-dark);
  }

  /* Su fondi sempre scuri (footer): eco viola costante —
     la fronte resta ereditata oro. */
  .mark--on-dark .mark__b-echo {
    color: var(--purple-on-dark);
  }

  /* L'eco: il secondo strato, in viola fuori registro.
     L'ampiezza può essere guidata dalla scena (--echo-spread). */
  .mark__b-echo {
    position: absolute;
    inset: 0;
    color: var(--mark-echo);
    z-index: -1;
    transform: translate(
      calc(0.085em + var(--echo-spread, 0em)),
      calc(0.05em + var(--echo-spread, 0em) * 0.55)
    );
  }

  /* Il terzo strato: viola profondo, visibile solo nella scena */
  .mark__b-deep {
    position: absolute;
    inset: 0;
    color: var(--purple-deep);
    z-index: -2;
    transform: translate(-0.05em, -0.12em);
    opacity: var(--echo-deep, 0);
  }

  .mark__sub {
    display: block;
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--text-md);
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .mark--on-dark .mark__sub {
    color: var(--on-dark-muted);
  }

  /* Dimensioni */
  .mark--hero {
    font-size: var(--text-hero);
  }
  .mark--footer {
    font-size: clamp(2.6rem, 7vw, 4.8rem);
  }

  /* Il footer ha un fondo opaco ma nessun contesto di stacking:
     senza questo, l'eco (z -1) verrebbe dipinta sotto al fondo. */
  .mark--footer .mark__visual {
    isolation: isolate;
  }

  /* Il momento coreografato: l'eco si mette in registro */
  @keyframes echo-register {
    from {
      transform: translate(0.42em, -0.18em);
      opacity: 0;
    }
    55% {
      opacity: 1;
    }
    to {
      transform: translate(
        calc(0.085em + var(--echo-spread, 0em)),
        calc(0.05em + var(--echo-spread, 0em) * 0.55)
      );
      opacity: 1;
    }
  }

  /* Lo stack dello slicer: copie a strati del wordmark (2026-10-13 h).
     Ogni strato: la propria banda con clip-path e dissolvenza legata
     al progresso (--pp), SENZA movimento di arrivo — la scritta si
     riempie a registro, mai mezza lettera fuori sede. Il contenitore
     è tagliato alla linea della testa (niente strato sopra, come la
     foto: `--k-photo-ghost`-gemello); la testa è sorella dello stack
     per non venire tagliata lei stessa. Ink: sparisce in dissolvenza e
     torna piena al rilascio (slide −14px ∝ ghost). */
  .mark__slicestack {
    position: absolute;
    inset: 0;
    display: block;
    --n: 40;
  }
  .mark__slice {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    pointer-events: none;
    /* Le copie sono inset: 0 e non ereditano il padding per far fluire
       il testo interno: stessе correzioni del base, altrimenti gli
       strati starebbero sfalsati rispetto all'inchiostro di riposo. */
    padding-top: 0.05em;
    padding-right: 0.08em;
  }
  .mark__slice-a,
  .mark__slice-b,
  .mark__slice-sub {
    display: block;
  }
  .mark__slice-a {
    color: var(--purple-display);
  }
  .mark__slice-b {
    color: var(--mark-layer);
  }
  .mark__slice-sub {
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--text-md);
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .mark__print-head {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--print-accent);
    opacity: 0;
    pointer-events: none;
  }

  /* ---- Scena "Deposizione": lo slicing della scritta (h) ---- */
  :global(.hero-stage[data-scene-live]) .mark__slicestack {
    /* Il vincolo orizzontale a 0 tagliava l'ink overflow dei glifi
       (la pancia della "e" di Clash Display esce dal box di layout,
       2026-10-13 i): −0.15em ai lati lascia respirare la scritta,
       −0.1em sotto copre i discendenti — il lavoro verticale resta
       intatto (strato per strato). */
    clip-path: inset(calc((1 - var(--pp, 0)) * 100%) -0.15em -0.1em -0.15em);
    will-change: clip-path;
  }
  :global(.hero-stage[data-scene-live]) .mark__slice {
    opacity: calc(
      clamp(0, calc(var(--pp, 0) * var(--n, 40) - var(--i, 0)), 1) *
        (1 - var(--k-pfade, 0))
    );
    clip-path: inset(
      calc((1 - (var(--i, 0) + 1) / var(--n, 40)) * 100%) -0.15em
        calc(var(--i, 0) / var(--n, 40) * 100%) -0.15em
    );
  }
  :global(.hero-stage[data-scene-live]) .mark__print-head {
    bottom: calc(var(--pp, 0) * 100%);
    /* Vita propria solo durante la stampa (--k-head), come la gemella
       della foto; mai durante la dissolvenza che la precede. */
    opacity: var(--k-head, 0);
  }

  :global(.hero-stage[data-scene-live]) .mark__visual {
    translate: 0 calc(var(--k-word-ghost, 0) * -14px);
    will-change: translate;
  }
  :global(.hero-stage[data-scene-live]) .mark__a,
  :global(.hero-stage[data-scene-live]) .mark__b,
  :global(.hero-stage[data-scene-live]) .mark__sub {
    opacity: calc(1 - var(--k-word-ghost, 0));
  }

  @media (prefers-reduced-motion: no-preference) {
    .mark--hero .mark__b-echo {
      animation: echo-register 0.75s var(--ease-snap) 0.2s both;
    }
  }
</style>
